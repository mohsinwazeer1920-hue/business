//////////////// virtual host ka tarika //////////////////

///step 1:folder bnao:

sudo mkdir -p /var/www/midcity

///permission set karo:

sudo chown -R $USER:$USER /var/www/midcity

///test file bnao: 

echo "<h1>Midcity Working ✅</h1>" > /var/www/midcity/index.html

///step 2:virtual host file bnao

sudo nano /etc/apache2/sites-available/midcity.conf

///isma ya code add kro:

<VirtualHost *:80>
    ServerName midcity.local
    DocumentRoot /var/www/midcity

    <Directory /var/www/midcity>
        AllowOverride All
        Require all granted
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/midcity_error.log
    CustomLog ${APACHE_LOG_DIR}/midcity_access.log combined
</VirtualHost>

//save krdo


///step 3:site enable kro

sudo a2ensite midcity.conf

///step 4:host file ma entry kro

sudo nano /etc/hosts

///niche ya line add kr or phir save and exit

127.0.0.1 midcity.local

///step 5:apache reload kro 

sudo systemctl reload apache2

